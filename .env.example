# ==============================================================================
# Kavach Environment Configuration Example
# Copy this file to .env for local development overrides.
# DO NOT commit real secrets or credentials to source control.
# ==============================================================================

# Core Application Settings
APP_NAME=Kavach
APP_ENV=development
APP_VERSION=0.1.0
DEBUG=False

# Server Network Configuration
APP_HOST=127.0.0.1
APP_PORT=8000

# API Routing
API_V1_PREFIX=/api/v1

# Logging
LOG_LEVEL=INFO
